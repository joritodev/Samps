# Database (use Neon pooler URL; prefer a region close to you for latency)
DATABASE_URL=

# Optional: set to 1 to log every Prisma SQL (slows the app a lot in dev)
# PRISMA_LOG_QUERIES=1

AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@samps.digital

# Imagens (capa do quadro). Em produção: Vercel Blob (Storage > Blob; cria o token ao conectar o store).
BLOB_READ_WRITE_TOKEN=
# Só dev local sem Blob: grava em public/uploads-dev. Nunca definir na Vercel.
# LOCAL_IMAGE_STORAGE=1
