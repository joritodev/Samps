  RESPONSIBLE_CHANGED
  DEADLINE_NEAR
  DEMAND_OVERDUE
  NEW_COMMENT
  ADJUSTMENT_REQUESTED
  PROJECT_UPDATED
  SHOOT_SCHEDULED
  INFO_RELEASED
  USER_INVITE
  OTHER
}

enum DemandDelayResolution {
  COMPLETED
  DEADLINE_EXTENDED
  CANCELLED
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  CLIENT_CREATED
  CLIENT_UPDATED
  BOARD_CREATED
  PORTAL_CREATED
  CARD_AUTO_CREATED
  BRIEFING_DEMANDED
  BRIEFING_LOCKED
  PRODUCTION_COMPLETED
  PUBLICATION_REGISTERED
  DEMAND_CREATED
  DEMAND_UPDATED
  RESPONSIBLE_CHANGED
  DEADLINE_CHANGED
