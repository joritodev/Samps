  AWAY
  BLOCKED
  INVITE_PENDING
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PAUSED
}

enum ContractStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  DRAFT
}

enum DemandType {
  FEED
  STORY
  REEL
  VIDEO
  DESIGN
  COPY
  FOLLOW_UP
  EXTRA
  PROJECT_TASK
  OTHER
}

enum DemandOrigin {
  CLIENT_BOARD
  SOCIAL_PANEL
  DESIGN_BOARD
  VIDEO_BOARD
  MANAGEMENT
  PROJECT
  EXTRA
}

enum DemandStatus {
