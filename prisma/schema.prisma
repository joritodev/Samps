}

enum AssignmentMethod {
  SELF
  LEADER
  MANAGEMENT
}

enum WorkSessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum WorkSessionStage {
  PRODUCTION
  ADJUSTMENT
  OTHER
}

enum DistributionMethod {
  SELF
  LEADER
  MANAGEMENT
  MIXED
}

enum AnnouncementKind {
  INFO
  URGENT
  CELEBRATION
}

enum AbsenceKind {
  DAY_OFF
  VACATION
  OFFLINE
  SICK_LEAVE
}

enum AgendaMeetingKind {
  MEETING
  PODCAST
  OTHER
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  name              String
  phone             String?
  avatarUrl         String?
  birthDate         DateTime?
  userType          UserType
  roleId            String
  sectorId          String?
  jobTitle          String?
  status            UserStatus @default(INVITE_PENDING)
  leaderId          String?
  mustResetPassword Boolean    @default(true)
  termsAcceptedAt   DateTime?
  internalNotes     String?
  notificationPrefs Json?
  joinedAt          DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  role         Role    @relation(fields: [roleId], references: [id])
  sector       Sector? @relation(fields: [sectorId], references: [id])
  leader       User?   @relation("UserLeader", fields: [leaderId], references: [id])
  subordinates User[]  @relation("UserLeader")

  permissionOverrides    UserPermissionOverride[]
  clientLinks            UserClientLink[]
  projectLinks           UserProjectLink[]
  assignedDemands        Demand[]                 @relation("DemandAssignee")
  requestedDemands       Demand[]                 @relation("DemandRequester")
  ownedProjects          Project[]                @relation("ProjectOwner")
  ownedShoots            Shoot[]                  @relation("ShootOwner")
  projectParticipants    ProjectParticipant[]
  shootParticipants      ShootParticipant[]
  comments               Comment[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  accessAttempts         AccessAttemptLog[]
  passwordResetTokens    PasswordResetToken[]
  invitesSent            UserInvite[]             @relation("InviteSender")
  invitesReceived        UserInvite[]             @relation("InviteRecipient")
  primaryClients         Client[]                 @relation("ClientPrimaryResponsible")
  socialClients          Client[]                 @relation("ClientSocialMedia")
  externalClients        Client[]                 @relation("ClientExternalResponsible")
  secondarySocialClients Client[]                 @relation("ClientSecondarySocial")
  accountLeaderClients   Client[]                 @relation("ClientAccountLeader")
  boardsCreated          ClientBoard[]            @relation("BoardCreator")
  briefingLockedDemands  Demand[]                 @relation("BriefingLocker")
  portalContacts         ClientPortal[]           @relation("PortalContact")
  releasedVisibility     ExternalVisibility[]
  ledSectors             Sector[]                 @relation("SectorLeader")
  demandAssignments      DemandAssignment[]       @relation("AssignmentExecutor")
  assignmentsMade        DemandAssignment[]       @relation("AssignmentAssigner")
  workSessions           WorkSession[]
  announcements          Announcement[]           @relation("AnnouncementAuthor")
  absences               Absence[]
  checklistItems         ChecklistItem[]
  agendaMeetings         AgendaMeeting[]          @relation("AgendaMeetingAuthor")
  goalsAbout             Goal[]                   @relation("GoalUser")
  goalsCreated           Goal[]                   @relation("GoalCreator")
  planMember             PlanMember?
  planCardsCreated       PlanCard[]               @relation("PlanCardCreator")
  reportsSeen            ReportSeen[]             @relation("ReportSeenUser")
  reportDeliveries       ReportDelivery[]         @relation("ReportDeliveryUser")
  objectivesOwned        Objective[]              @relation("ObjectiveOwner")
  objectivesAbout        Objective[]              @relation("ObjectiveUser")
  objectivesCreated      Objective[]              @relation("ObjectiveCreator")
  checkInsAuthored       KeyResultCheckIn[]       @relation("CheckInAuthor")

  @@index([userType])
  @@index([status])
  @@index([roleId])
}

enum KpiMetric {
  COMPLETED
  ON_TIME_RATE
  OVERDUE
  REWORK_RATE
  ADJUSTMENTS
  WORKED_HOURS
  AVG_LEAD_TIME_DAYS
  UNASSIGNED_OPEN
}

enum GoalScope {
  AGENCY
  SECTOR
  USER
}

/// Meta de um indicador (KPI) para a agência, um setor ou uma pessoa.
/// `target` na unidade do indicador (percentual é razão de 0 a 1).
/// `startsOn`/`endsOn`: primeiro e último instante do período (dias de São Paulo).
model Goal {
  id          String    @id @default(cuid())
  metric      KpiMetric
  scope       GoalScope
  sectorId    String?
  userId      String?
  target      Float
  warnMargin  Float     @default(0.1)
  startsOn    DateTime
  endsOn      DateTime
  note        String?
  active      Boolean   @default(true)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sector    Sector? @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user      User?   @relation("GoalUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User    @relation("GoalCreator", fields: [createdById], references: [id])

  @@index([scope, sectorId])
  @@index([userId])
  @@index([startsOn, endsOn])
}

enum ObjectiveStatus {
  ACTIVE
  DONE
  CANCELLED
}

enum KeyResultKind {
  KPI
  MANUAL
}

enum Confidence {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

/// Objetivo (OKR) da agência, de um setor ou de uma pessoa, com resultados-chave.
/// O pai precisa ter escopo mais amplo (agência > setor > pessoa).
model Objective {
  id          String          @id @default(cuid())
  title       String
  description String?
  ownerId     String
  scope       GoalScope
  sectorId    String?
  userId      String?
  parentId    String?
  startsOn    DateTime
  endsOn      DateTime
  status      ObjectiveStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner      User        @relation("ObjectiveOwner", fields: [ownerId], references: [id])
  sector     Sector?     @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user       User?       @relation("ObjectiveUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy  User        @relation("ObjectiveCreator", fields: [createdById], references: [id])
  parent     Objective?  @relation("ObjectiveTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Objective[] @relation("ObjectiveTree")
  keyResults KeyResult[]

  @@index([scope, sectorId])
  @@index([userId])
  @@index([ownerId])
  @@index([parentId])
  @@index([startsOn, endsOn])
}

/// Resultado-chave. `KPI` calcula o valor atual de um indicador; `MANUAL`
/// usa o último check-in (`currentValue`). Percentual em razão de 0 a 1.
model KeyResult {
  id           String        @id @default(cuid())
  objectiveId  String
  title        String
  kind         KeyResultKind
  metric       KpiMetric?
  unit         String?
  startValue   Float         @default(0)
  targetValue  Float
  currentValue Float?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  objective Objective          @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  checkIns  KeyResultCheckIn[]

  @@index([objectiveId, sortOrder])
}

model KeyResultCheckIn {
  id          String     @id @default(cuid())
  keyResultId String
  authorId    String
  value       Float
  confidence  Confidence
  note        String?
  createdAt   DateTime   @default(now())

  keyResult KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  author    User      @relation("CheckInAuthor", fields: [authorId], references: [id])

  @@index([keyResultId, createdAt])
}

/// Dia (de São Paulo) em que a pessoa já viu ou dispensou o resumo diário.
model ReportSeen {
  id        String   @id @default(cuid())
  userId    String
  day       String
  createdAt DateTime @default(now())

  user User @relation("ReportSeenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

enum ReportKind {
  LEADER_DAILY
  MANAGEMENT_WEEKLY
}

enum DeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

/// Registro de cada e-mail de resumo: garante um envio por pessoa e período.
model ReportDelivery {
  id        String         @id @default(cuid())
  userId    String
  kind      ReportKind
  periodKey String
  status    DeliveryStatus
  error     String?
  createdAt DateTime       @default(now())

  user User @relation("ReportDeliveryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, periodKey])
  @@index([createdAt])
}

model Announcement {
  id        String           @id @default(cuid())
  title     String
  message   String
  kind      AnnouncementKind @default(INFO)
  startsAt  DateTime         @default(now())
  endsAt    DateTime?
  active    Boolean          @default(true)
  authorId  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  author User @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  @@index([active, startsAt])
}

model Absence {
  id         String      @id @default(cuid())
  userId     String
  kind       AbsenceKind
  startsAt   DateTime
  endsAt     DateTime
  note       String?
  canceledAt DateTime?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@index([startsAt, endsAt])
}

model AgendaMeeting {
  id          String            @id @default(cuid())
  title       String
  description String?
  meetingUrl  String?
  location    String?
  kind        AgendaMeetingKind @default(MEETING)
  startsAt    DateTime
  endsAt      DateTime?
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  createdBy User @relation("AgendaMeetingAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([startsAt])
  @@index([createdById])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  roles     RolePermission[]
  overrides UserPermissionOverride[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserPermissionOverride {
  id           String  @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model UserInvite {
  id          String    @id @default(cuid())
  email       String
  userId      String?
  invitedById String
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  invitedBy User  @relation("InviteSender", fields: [invitedById], references: [id])
  user      User? @relation("InviteRecipient", fields: [userId], references: [id])
}

model AgencySettings {
  id            String   @id @default("default")
  name          String   @default("Samps Digital")
  logoUrl       String?
  timezone      String   @default("America/Sao_Paulo")
  language      String   @default("pt-BR")
  dateFormat    String   @default("dd/MM/yyyy")
  workStartTime String   @default("09:00")
  workEndTime   String   @default("18:00")
  workDays      String   @default("1,2,3,4,5")
  holidays      Json     @default("[]")
  portalName    String   @default("Portal do Cliente")
  portalLogoUrl String?
  portalColor   String   @default("#0f172a")
  updatedAt     DateTime @updatedAt
}

model Sector {
  id                 String             @id @default(cuid())
  name               String             @unique
  slug               String             @unique
  color              String?
  isActive           Boolean            @default(true)
  leaderId           String?
  distributionMethod DistributionMethod @default(MIXED)
  createdAt          DateTime           @default(now())

  leader         User?              @relation("SectorLeader", fields: [leaderId], references: [id])
  users          User[]
  demands        Demand[]
  assignments    DemandAssignment[]
  priorityScores PriorityScore[]
  designBoards   ClientBoard[]      @relation("BoardDesignSector")
  videoBoards    ClientBoard[]      @relation("BoardVideoSector")
  goals          Goal[]
  planMembers    PlanMember[]
  planCards      PlanCard[]
  planTemplates  PlanTemplate[]
  planDayBlocks  PlanDayBlock[]
  planPresets    PlanPreset[]
  objectives     Objective[]
}

model ContentType {
  id                  String   @id @default(cuid())
  name                String   @unique
  slug                String   @unique
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  requiresDuration    Boolean  @default(false)
  requiresFormat      Boolean  @default(false)
  requiresCaption     Boolean  @default(false)
  requiresReference   Boolean  @default(false)
  requiresRawDelivery Boolean  @default(false)
  createdAt           DateTime @default(now())

  demands          Demand[]
  contractServices ContractService[]
}

model PriorityLevel {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  weight    Int      @default(0)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  demands    Demand[]
  checklists Checklist[] @relation("ChecklistPriority")
}

model ActivityStatusConfig {
  id         String      @id @default(cuid())
  name       String
  slug       String
  color      String?
  demandType DemandType?
  sortOrder  Int         @default(0)
  isActive   Boolean     @default(true)
  isFinal    Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@unique([slug, demandType])
}

model Client {
  id                     String       @id @default(cuid())
  name                   String
  legalName              String?
  tradeName              String?
  segment                String?
  email                  String?
  phone                  String?
  logoUrl                String?
  brandColor             String?
  birthDate              DateTime?
  addressZip             String?
  addressStreet          String?
  addressNumber          String?
  addressComplement      String?
  addressDistrict        String?
  addressCity            String?
  addressState           String?
  contractDocUrl         String?
  studyDocUrl            String?
  status                 ClientStatus @default(ACTIVE)
  primaryResponsibleId   String?
  socialMediaId          String?
  secondarySocialMediaId String?
  accountLeaderId        String?
  externalResponsibleId  String?
  startedAt              DateTime?
  internalNotes          String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  primaryResponsible   User?                @relation("ClientPrimaryResponsible", fields: [primaryResponsibleId], references: [id])
  socialMedia          User?                @relation("ClientSocialMedia", fields: [socialMediaId], references: [id])
  secondarySocialMedia User?                @relation("ClientSecondarySocial", fields: [secondarySocialMediaId], references: [id])
  accountLeader        User?                @relation("ClientAccountLeader", fields: [accountLeaderId], references: [id])
  externalResponsible  User?                @relation("ClientExternalResponsible", fields: [externalResponsibleId], references: [id])
  userLinks            UserClientLink[]
  contracts            Contract[]
  demands              Demand[]
  planCards            PlanCard[]
  planTemplates        PlanTemplate[]
  projects             Project[]
  shoots               Shoot[]
  attachments          Attachment[]
  externalVisibility   ExternalVisibility[]
  board                ClientBoard?
  portal               ClientPortal?
  demandDelays         DemandDelay[]
}

model Contract {
  id                     String         @id @default(cuid())
  clientId               String
  planName               String?
  startDate              DateTime
  endDate                DateTime?
  renewalDay             Int?
  initialCompetenceMonth Int?
  initialCompetenceYear  Int?
  status                 ContractStatus @default(ACTIVE)
  notes                  String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  client   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  services ContractService[]
  boards   ClientBoard[]
}

model ContractService {
  id            String      @id @default(cuid())
  contractId    String
  name          String
  quantity      Int?
  demandType    DemandType?
  contentTypeId String?
  periodicity   String      @default("monthly")
  isActive      Boolean     @default(true)
  notes         String?

  contract    Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contentType ContentType? @relation(fields: [contentTypeId], references: [id])
  demands     Demand[]
}

model UserClientLink {
  id         String   @id @default(cuid())
  userId     String
  clientId   String
  linkType   LinkType @default(USER_CLIENT)
  permission String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
}

model UserProjectLink {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Demand {
  id                    String           @id @default(cuid())
  clientId              String
  boardId               String?
  listId                String?
  competenceId          String?
  contractServiceId     String?
  title                 String
  description           String?
  type                  DemandType       @default(OTHER)
  origin                DemandOrigin     @default(CLIENT_BOARD)
  format                String?
  objective             DemandObjective?
  platform              String?
  complexityLevel       Int?
  sectorId              String?
  assigneeId            String?
  requesterId           String?
  priorityId            String?
  contentTypeId         String?
  status                DemandStatus     @default(OPEN)
  internalStatus        String?
  externalStatus        String?
  boardColumn           String           @default("open")
  sortOrder             Int              @default(0)
  cardCode              String?
  cardIndex             Int?
  cardTotalInType       Int?
  isContractual         Boolean          @default(false)
  dueDate               DateTime?
  demandDeadline        DateTime?
  deliveryDate          DateTime?
  publishDate           DateTime?
  briefingLockedAt      DateTime?
  briefingLockedById    String?
  slidesCount           Int?
  screensCount          Int?
  durationSeconds       Int?
  orientation           String?
  caption               String?
  briefingReference     String?
  rawDelivery           Boolean?
  rawMaterialAvailable  Boolean?
  scriptAvailable       Boolean?
  productionStartedAt   DateTime?
  productionCompletedAt DateTime?
  publishedAt           DateTime?
  publishedUrl          String?
  deliveredAt           DateTime?
  visibleToClient       Boolean          @default(false)
  externalVisibleFields Json?
  timerState            Json?
  projectId             String?
  materialUrl           String?
  scheduledExecutionAt  DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  parentDemandId  String?
  checklistOrder  Int?
  isChecklistItem Boolean @default(false)

  client              Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  board               ClientBoard?       @relation(fields: [boardId], references: [id])
  list                BoardList?         @relation(fields: [listId], references: [id])
  competence          Competence?        @relation(fields: [competenceId], references: [id])
  contractService     ContractService?   @relation(fields: [contractServiceId], references: [id])
  sector              Sector?            @relation(fields: [sectorId], references: [id])
  assignee            User?              @relation("DemandAssignee", fields: [assigneeId], references: [id])
  requester           User?              @relation("DemandRequester", fields: [requesterId], references: [id])
  briefingLockedBy    User?              @relation("BriefingLocker", fields: [briefingLockedById], references: [id])
  priority            PriorityLevel?     @relation(fields: [priorityId], references: [id])
  contentType         ContentType?       @relation(fields: [contentTypeId], references: [id])
  project             Project?           @relation(fields: [projectId], references: [id])
  parentDemand        Demand?            @relation("DemandChecklist", fields: [parentDemandId], references: [id], onDelete: Cascade)
  childDemands        Demand[]           @relation("DemandChecklist")
  checklists          Checklist[]
  linkedChecklistItem ChecklistItem?
  comments            Comment[]
  planCards           PlanCard[]
  attachments         Attachment[]
  assignments         DemandAssignment[]
  workSessions        WorkSession[]
  priorityScores      PriorityScore[]
  demandDelays        DemandDelay[]

  @@index([clientId])
  @@index([boardId])
  @@index([listId])
  @@index([competenceId])
  @@index([assigneeId])
  @@index([sectorId])
  @@index([status])
  @@index([boardColumn])
  @@index([dueDate])
  @@index([parentDemandId])
}

model Checklist {
  id          String   @id @default(cuid())
  demandId    String
  title       String
  description String?
  priorityId  String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  demand   Demand          @relation(fields: [demandId], references: [id], onDelete: Cascade)
  priority PriorityLevel?  @relation("ChecklistPriority", fields: [priorityId], references: [id], onDelete: SetNull)
  items    ChecklistItem[]

  @@index([demandId])
  @@index([priorityId])
}

model ChecklistItem {
  id             String    @id @default(cuid())
  checklistId    String
  title          String
  isDone         Boolean   @default(false)
  sortOrder      Int       @default(0)
  assigneeId     String?
  dueDate        DateTime?
  linkedDemandId String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  checklist    Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  assignee     User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  linkedDemand Demand?   @relation(fields: [linkedDemandId], references: [id], onDelete: SetNull)

  @@index([checklistId])
  @@index([assigneeId])
}

model DemandDelay {
  id              String                 @id @default(cuid())
  demandId        String
  clientId        String
  originalDueDate DateTime
  detectedAt      DateTime               @default(now())
  resolvedAt      DateTime?
  resolution      DemandDelayResolution?
  daysOverdue     Int                    @default(0)
  createdAt       DateTime               @default(now())

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([demandId])
  @@index([clientId])
  @@index([detectedAt])
  @@index([resolvedAt])
}

model DemandAssignment {
  id           String            @id @default(cuid())
  demandId     String
  sectorId     String
  executorId   String?
  assignedById String?
  assignedAt   DateTime          @default(now())
  status       AssignmentStatus  @default(AVAILABLE)
  method       AssignmentMethod?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  demand     Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  sector     Sector @relation(fields: [sectorId], references: [id])
  executor   User?  @relation("AssignmentExecutor", fields: [executorId], references: [id])
  assignedBy User?  @relation("AssignmentAssigner", fields: [assignedById], references: [id])

  @@index([demandId])
  @@index([sectorId])
  @@index([executorId])
  @@index([status])
}

model WorkSession {
  id                 String            @id @default(cuid())
  demandId           String
  userId             String
  stage              WorkSessionStage  @default(PRODUCTION)
  status             WorkSessionStatus @default(ACTIVE)
  startedAt          DateTime          @default(now())
  endedAt            DateTime?
  totalActiveSeconds Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  demand Demand      @relation(fields: [demandId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id])
  pauses WorkPause[]

  @@index([demandId])
  @@index([userId])
  @@index([status])
}

model WorkPause {
  id          String    @id @default(cuid())
  sessionId   String
  reason      String
  description String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  session WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model PriorityScore {
  id           String   @id @default(cuid())
  demandId     String
  sectorId     String
  score        Float    @default(0)
  rank         Int?
  calculatedAt DateTime @default(now())
  criteria     Json     @default("{}")

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  sector Sector @relation(fields: [sectorId], references: [id])

  @@unique([demandId, sectorId])
  @@index([sectorId, score])
}

model ClientBoard {
  id                  String      @id @default(cuid())
  clientId            String      @unique
  name                String
  status              BoardStatus @default(ACTIVE)
  currentCompetenceId String?
  contractId          String?
  designSectorId      String?
  videoSectorId       String?
  config              Json        @default("{}")
  createdById         String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  client            Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contract          Contract?     @relation(fields: [contractId], references: [id])
  createdBy         User          @relation("BoardCreator", fields: [createdById], references: [id])
  currentCompetence Competence?   @relation("BoardCurrentCompetence", fields: [currentCompetenceId], references: [id])
  designSector      Sector?       @relation("BoardDesignSector", fields: [designSectorId], references: [id])
  videoSector       Sector?       @relation("BoardVideoSector", fields: [videoSectorId], references: [id])
  lists             BoardList[]
  competences       Competence[]
  demands           Demand[]
  portal            ClientPortal?

  @@index([status])
}

model BoardList {
  id        String        @id @default(cuid())
  boardId   String
  name      String
  type      BoardListType
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())

  board   ClientBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  demands Demand[]

  @@index([boardId, sortOrder])
  @@index([boardId, active])
}

model Competence {
  id       String           @id @default(cuid())
  boardId  String
  month    Int
  year     Int
  status   CompetenceStatus @default(OPEN)
  openedAt DateTime         @default(now())
  closedAt DateTime?

  board   ClientBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  demands Demand[]

  /// Preenchido quando esta competência é a vigente do quadro.
  /// Lista por exigência do Prisma; na prática tem no máximo um item,
  /// já que Competence.boardId aponta para um único quadro.
  currentForBoards ClientBoard[] @relation("BoardCurrentCompetence")

  @@unique([boardId, month, year])
}

model ClientPortal {
  id                  String       @id @default(cuid())
  clientId            String       @unique
  boardId             String       @unique
  displayName         String
  logoUrl             String?
  primaryColor        String?
  status              PortalStatus @default(DRAFT)
  agencyContactName   String?
  agencyContactUserId String?
  config              Json         @default("{}")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  client            Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  board             ClientBoard          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  agencyContactUser User?                @relation("PortalContact", fields: [agencyContactUserId], references: [id])
  visibility        ExternalVisibility[]
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  title       String
  description String?
  ownerId     String?
  status      ProjectStatus @default(PLANNING)
  progress    Int           @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client       Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner        User?                  @relation("ProjectOwner", fields: [ownerId], references: [id])
  demands      Demand[]
  checklist    ProjectChecklistItem[]
  participants ProjectParticipant[]
  userLinks    UserProjectLink[]
}

model ProjectChecklistItem {
  id        String   @id @default(cuid())
  projectId String
  title     String
  isDone    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectParticipant {
  id        String @id @default(cuid())
  projectId String
  userId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Shoot {
  id        String      @id @default(cuid())
  clientId  String
  title     String
  date      DateTime
  startTime String?
  endTime   String?
  location  String?
  ownerId   String?
  shootType String?
  status    ShootStatus @default(PLANNED)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner        User?              @relation("ShootOwner", fields: [ownerId], references: [id])
  participants ShootParticipant[]
}

model ShootParticipant {
  id      String @id @default(cuid())
  shootId String
  userId  String

  shoot Shoot @relation(fields: [shootId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shootId, userId])
}

model Comment {
  id          String            @id @default(cuid())
  userId      String
  demandId    String?
  entityType  String?
  entityId    String?
  text        String
  commentType CommentType       @default(GENERAL)
  visibility  CommentVisibility @default(INTERNAL)
  createdAt   DateTime          @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  demand Demand? @relation(fields: [demandId], references: [id], onDelete: Cascade)
}

model Attachment {
  id              String   @id @default(cuid())
  clientId        String?
  demandId        String?
  entityType      String?
  entityId        String?
  name            String
  url             String
  fileType        String?
  visibleToClient Boolean  @default(false)
  createdAt       DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  demand Demand? @relation(fields: [demandId], references: [id], onDelete: Cascade)
}

model ExternalVisibility {
  id            String    @id @default(cuid())
  entityType    String
  entityId      String
  clientId      String
  portalId      String?
  visible       Boolean   @default(true)
  visibleFields Json?
  releasedAt    DateTime  @default(now())
  releasedById  String?
  removedAt     DateTime?

  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  portal     ClientPortal? @relation(fields: [portalId], references: [id])
  releasedBy User?         @relation(fields: [releasedById], references: [id])

  @@index([entityType, entityId])
  @@index([clientId])
}

model AuditLog {
  id            String      @id @default(cuid())
  userId        String?
  action        AuditAction
  entityType    String?
  entityId      String?
  previousValue Json?
  newValue      Json?
  origin        String?
  ipAddress     String?
  createdAt     DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AccessAttemptLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  success   Boolean
  reason    String?
  ipAddress String?
  path      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Planejamento semanal de produção (Design e Vídeo)
// Spec: docs/superpowers/specs/2026-10-09-planejamento-semanal-design.md
// CHECKs, RLS e permissões vivem na migration 20261009120000_planning_foundation.
// ---------------------------------------------------------------------------

enum PlanCardStatus {
  NAO_ALOCADO
  PROGRAMADO
  EM_EDICAO
  REVISAO
  CONCLUIDO
}

/// Pessoa que aparece como linha do quadro: configuração própria (cor, capacidade).
model PlanMember {
  id                   String   @id @default(cuid())
  userId               String   @unique
  sectorId             String
  color                String   @default("#1d4ed8")
  defaultCapacityHours Decimal  @default(6) @db.Decimal(4, 2)
  sortOrder            Int      @default(0)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector    Sector                 @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  cards     PlanCard[]
  templates PlanTemplate[]
  blocks    PlanDayBlock[]
  overrides PlanCapacityOverride[]

  @@index([sectorId, active, sortOrder])
}

/// Modelo de demanda recorrente: gera cards toda semana.
model PlanTemplate {
  id                String   @id @default(cuid())
  sectorId          String
  clientId          String?
  title             String
  kind              String
  category          String   @default("Outro")
  durationHours     Decimal  @db.Decimal(5, 2)
  weeklyQuantity    Int      @default(1)
  preferredMemberId String?
  preferredWeekday  Int?     @db.SmallInt
  required          Boolean  @default(true)
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sector          Sector      @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  client          Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  preferredMember PlanMember? @relation(fields: [preferredMemberId], references: [id], onDelete: SetNull)
  cards           PlanCard[]

  @@index([sectorId, active, sortOrder])
}

/// Card do quadro semanal. Sem dia ou sem pessoa = backlog ("não alocado").
model PlanCard {
  id            String         @id @default(cuid())
  sectorId      String
  isoYear       Int
  isoWeek       Int
  weekday       Int?           @db.SmallInt
  memberId      String?
  kind          String
  clientId      String?
  clientName    String?
  demandId      String?
  templateId    String?
  title         String
  category      String         @default("Outro")
  durationHours Decimal        @db.Decimal(7, 4)
  status        PlanCardStatus @default(NAO_ALOCADO)
  pinned        Boolean        @default(false)
  required      Boolean        @default(false)
  recurring     Boolean        @default(false)
  dueDate       DateTime?      @db.Date
  notes         String?
  position      Int            @default(0)
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sector    Sector        @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  member    PlanMember?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  demand    Demand?       @relation(fields: [demandId], references: [id], onDelete: SetNull)
  template  PlanTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("PlanCardCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sectorId, isoYear, isoWeek])
  @@index([memberId, isoYear, isoWeek])
  @@index([demandId])
}

/// Bloqueio de dia (feriado, evento). memberId nulo = setor inteiro.
model PlanDayBlock {
  id        String   @id @default(cuid())
  sectorId  String
  isoYear   Int
  isoWeek   Int
  weekday   Int      @db.SmallInt
  memberId  String?
  reason    String   @default("Bloqueado")
  createdAt DateTime @default(now())

  sector Sector      @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  member PlanMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([sectorId, isoYear, isoWeek])
}

/// Capacidade diferente do padrão: por dia da semana (fixo) ou por dia de uma semana específica.
/// Sem unique no banco (colunas nulas); o serviço substitui a linha em transação.
model PlanCapacityOverride {
  id        String   @id @default(cuid())
  memberId  String
  weekday   Int?     @db.SmallInt
  isoYear   Int?
  isoWeek   Int?
  hours     Decimal  @db.Decimal(4, 2)
  createdAt DateTime @default(now())

  member PlanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

/// Durações rápidas por setor ("Tipos de produção"; no Design, os tempos-padrão das peças).
model PlanPreset {
  id        String  @id @default(cuid())
  sectorId  String
  label     String
  hours     Decimal @db.Decimal(6, 4)
  sortOrder Int     @default(0)

  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Restrict)

  @@unique([sectorId, label])
}
